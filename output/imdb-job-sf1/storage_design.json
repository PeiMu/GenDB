{
  "persistent_storage": {
    "format": "binary_columnar",
    "base_dir_name": "imdb-job-sf1.gendb",
    "layout": {
      "fixed_column": "<table>/<col>.bin (raw little-endian array of cpp_type)",
      "varlen_column": "<table>/<col>.offsets.bin (uint64, N+1 entries) + <table>/<col>.data.bin (raw bytes); row i bytes = data[off[i]..off[i+1])",
      "row_count_file": "<table>/__row_count.bin (uint64)",
      "csr_index_primary": "indexes/<table>__<col>__offsets.bin (uint64[max_id+2]); rows physically sorted by <col>; rows for value v = [off[v]..off[v+1])",
      "csr_index_aux":     "indexes/<table>__<col>__offsets.bin (uint64[max_id+2]) + indexes/<table>__<col>__rowids.bin (int32[N]); rows for value v are the int32 row positions rowids[off[v]..off[v+1])",
      "pk_pos_dense":      "indexes/<table>__<col>__pos.bin (int32[max_id+2]); pos[id] = row position in column files for that id, or -1 if absent"
    },
    "null_sentinels": {"int32": -1, "char": 0, "varlen": "empty string (offset[i] == offset[i+1])"}
  },
  "type_mappings": {"INTEGER": "int32_t", "VARCHAR": "varlen", "TEXT": "varlen", "DATE": "int32_t", "CHAR1": "char"},
  "date_encoding": "days_since_epoch_1970 (unused — IMDB has no DATE columns in workload)",
  "csv_format": {"delimiter": ",", "quote": "\"", "escape_doubled_quote": true, "null_token": "", "embedded_newlines_in_quoted_strings": true},
  "hardware_config": {"cpu_cores": 12, "cpu_physical": 6, "l3_cache_mb": 12, "disk_type": "ssd", "total_memory_gb": 62},
  "design_notes": {
    "philosophy": "Star-schema IMDB workload, all MIN aggregates, no GROUP BY. Optimize FK joins via CSR offsets (sorted fact tables) and dense PK position arrays (dimension tables). Retain raw text for LIKE filters — no dictionary encoding on text columns.",
    "fact_sorting": "Each fact table is physically sorted by its primary FK (movie_id or person_id) at index-build time. Primary CSR = O(1) probe-list lookup by FK value with zero indirection.",
    "secondary_indexes": "CSR aux indexes give sorted rowid lists for non-primary FKs hit by selective dimension filters (e.g., cast_info.role_id, movie_keyword.keyword_id).",
    "pk_lookup": "Dimension tables sorted by id; pos_by_id[id] array gives O(1) row position for FK -> dimension joins (use case: after CSR probe in fact table, look up dimension attributes by id).",
    "skipped_columns": "CSV columns never referenced by any of the 113 JOB queries are skipped at ingestion (md5sum, imdb_id, phonetic_code, etc.) — saves IO and decode time."
  },
