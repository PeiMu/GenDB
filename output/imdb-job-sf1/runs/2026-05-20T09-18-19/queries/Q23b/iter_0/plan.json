{
  "query_id": "Q23b",
  "pipeline": [
    "resolve_dims",
    "scan_title_driver",
    "probe_cc_via_offsets",
    "probe_mk_via_offsets",
    "probe_mc_via_offsets",
    "probe_mi_via_offsets",
    "aggregate_min"
  ],
  "startup_resolution": [
    {"target": "cct1_id", "table": "comp_cast_type", "predicate": "kind = 'complete+verified'", "result": "scalar int32"},
    {"target": "us_code", "table": "company_name", "predicate": "country_code = '[us]'", "result": "dict_code int (resolved from country_code dictionary)"},
    {"target": "it1_id", "table": "info_type", "predicate": "info = 'release dates'", "result": "scalar int32"},
    {"target": "kt_id", "table": "kind_type", "predicate": "kind = 'movie'", "result": "scalar int32; also capture kind string for MIN projection"},
    {"target": "kw_ids", "table": "keyword", "predicate": "keyword IN ('nerd','loner','alienation','dignity')", "result": "flat_hash_set<int32_t> size<=4"}
  ],
  "join_order": [
    {
      "build": "title_driver (production_year>2000 AND kind_id==kt_id)",
      "probe": "complete_cast via offsets_index[movie_id]",
      "type": "semi",
      "strategy": "index_nested_loop",
      "build_cardinality": 700000,
      "notes": "Per surviving title v: scan cc rows in [off_cc[v], off_cc[v+1]); require ANY status_id == cct1_id. Very selective."
    },
    {
      "build": "title survivors after cc",
      "probe": "movie_keyword via offsets_index[movie_id]",
      "type": "semi",
      "strategy": "index_nested_loop",
      "build_cardinality": 80000,
      "notes": "Per v: scan mk rows; require ANY kw_ids.contains(keyword_id). 4 ids out of 134k => extremely selective."
    },
    {
      "build": "title survivors after mk",
      "probe": "movie_companies via offsets_index[movie_id]",
      "type": "semi",
      "strategy": "index_nested_loop",
      "build_cardinality": 5000,
      "notes": "Per v: scan mc rows; require ANY country_code[company_id-1] == us_code. Also need company_type — ct has 4 rows id-identity, no filter needed (every mc row passes ct join trivially)."
    },
    {
      "build": "title survivors after mc",
      "probe": "movie_info via offsets_index[movie_id]",
      "type": "semi",
      "strategy": "index_nested_loop",
      "build_cardinality": 2000,
      "notes": "Per v: scan mi rows; require info_type_id==it1_id AND note LIKE '%internet%' (memmem) AND info startswith 'USA:' (memcmp 4B) AND info contains ' 200' (memmem). Apply cheapest filters first: int eq -> note memmem -> info prefix memcmp -> info memmem."
    }
  ],
  "filters": [
    {"table": "title", "predicate": "production_year > 2000", "selectivity": 0.35},
    {"table": "title", "predicate": "kind_id == kt_id (movie)", "selectivity": 0.8},
    {"table": "complete_cast", "predicate": "status_id == cct1_id", "selectivity": 0.5, "notes": "semi-join existence per movie"},
    {"table": "movie_keyword", "predicate": "kw_ids.contains(keyword_id)", "selectivity": 0.00003, "notes": "4 of 134170 kw ids; very selective semi"},
    {"table": "movie_companies", "predicate": "country_code[company_id-1] == us_code", "selectivity": 0.5, "notes": "semi per movie"},
    {"table": "movie_info", "predicate": "info_type_id == it1_id", "selectivity": 0.05},
    {"table": "movie_info", "predicate": "note LIKE '%internet%'", "selectivity": 0.001},
    {"table": "movie_info", "predicate": "info LIKE 'USA:% 200%'", "selectivity": 0.02}
  ],
  "data_structures": {
    "kw_ids": "flat_hash_set<int32_t> (size 4)",
    "country_code_lookup": "direct array company_name.country_code[] indexed by company_id-1",
    "title_driver": "loop over title rows; no materialization needed",
    "offsets_indexes": {
      "complete_cast": "_idx/complete_cast__movie_id__offsets.bin (int32, length 2528314)",
      "movie_keyword": "_idx/movie_keyword__movie_id__offsets.bin",
      "movie_companies": "_idx/movie_companies__movie_id__offsets.bin",
      "movie_info": "_idx/movie_info__movie_id__offsets.bin"
    },
    "aggregation": "two scalar MIN reducers (one for kt.kind constant, one for t.title via offset+length compare)"
  },
  "parallelism": {
    "strategy": "morsel_driven over title row range",
    "threads": "auto(nproc)",
    "morsel_size": 16384,
    "reduction": "per-thread local MIN(title) and MIN(kind); final reduce across threads"
  },
  "indexes": [
    {"index": "complete_cast__movie_id__offsets", "purpose": "join_lookup per title v"},
    {"index": "movie_keyword__movie_id__offsets", "purpose": "join_lookup per title v"},
    {"index": "movie_companies__movie_id__offsets", "purpose": "join_lookup per title v"},
    {"index": "movie_info__movie_id__offsets", "purpose": "join_lookup per title v"}
  ],
  "aggregation": "scalar_min_min",
  "output": {
    "order_by": [],
    "limit": 1,
    "projection": ["MIN(kt.kind) AS movie_kind", "MIN(t.title) AS complete_nerdy_internet_movie"]
  },
  "short_circuit": {
    "per_movie": "After each semi-join probe finds a match, break inner loop and proceed to next stage; movie qualifies only if all four facts pass.",
    "min_title_skip": "When local MIN(title) already determined, can compare candidate t.title against current MIN before doing expensive mi LIKE filtering to short-circuit (optional micro-opt)."
  },
  "execution_target": "cpp"
}
