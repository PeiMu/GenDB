{
  "query_id": "Q27b",
  "pipeline": [
    "build_dim_sets",
    "drive_movie_keyword_sequel",
    "filter_title_year_1998",
    "semi_join_movie_link",
    "semi_join_movie_companies",
    "semi_join_complete_cast",
    "semi_join_movie_info",
    "aggregate_min3"
  ],
  "dim_builds": [
    {
      "name": "cct1_set",
      "table": "comp_cast_type",
      "predicate": "kind IN ('cast','crew')",
      "structure": "small_id_set (max 4 ids, linear scan)",
      "cardinality": 2
    },
    {
      "name": "complete_id",
      "table": "comp_cast_type",
      "predicate": "kind = 'complete'",
      "structure": "scalar int32",
      "cardinality": 1
    },
    {
      "name": "pl_code",
      "table": "company_name.country_code dict",
      "predicate": "dict entry '[pl]'",
      "structure": "scalar int16 (sentinel -1 if absent)"
    },
    {
      "name": "cn_set",
      "table": "company_name",
      "predicate": "country_code != pl_code AND (name memmem 'Film' OR memmem 'Warner')",
      "structure": "bitset(234997)",
      "notes": "also store cn_name varlen pointers for MIN(cn.name) output"
    },
    {
      "name": "ct_id",
      "table": "company_type",
      "predicate": "kind = 'production companies'",
      "structure": "scalar int32",
      "cardinality": 1
    },
    {
      "name": "sequel_kw_id",
      "table": "keyword",
      "predicate": "keyword = 'sequel'",
      "structure": "scalar int32",
      "cardinality": 1
    },
    {
      "name": "lt_set",
      "table": "link_type",
      "predicate": "link memmem 'follow'",
      "structure": "small_id_array + bitset(18)",
      "notes": "also keep link_type.link varlen for MIN(lt.link) output"
    },
    {
      "name": "mi_info_set",
      "predicate": "info IN ('Sweden','Germany','Swedish','German')",
      "structure": "inline 4-literal compare at probe time (length-first dispatch)"
    }
  ],
  "join_order": [
    {
      "build": "movie_keyword CSR on keyword_id=sequel_kw_id",
      "probe": "[lo,hi) yields candidate t_ids",
      "type": "driver",
      "strategy": "csr_index_range",
      "build_cardinality": "~2700 rows for 'sequel'",
      "notes": "deduplicate t_id via local visited set if needed; cheapest entry point"
    },
    {
      "build": "title.production_year",
      "probe": "t_id direct lookup",
      "type": "filter",
      "strategy": "direct_array_lookup",
      "notes": "==1998 prunes ~98.5% of sequel candidates first"
    },
    {
      "build": "lt_set",
      "probe": "movie_link via movie_id offsets index",
      "type": "semi",
      "strategy": "offsets_lookup_then_membership_test",
      "notes": "for r in [off[t_id],off[t_id+1]): if lt_set.contains(link_type_id[r]) record link_type_id for MIN output"
    },
    {
      "build": "ct_id + cn_set + note IS NULL",
      "probe": "movie_companies via movie_id offsets index",
      "type": "semi",
      "strategy": "offsets_lookup_with_compound_predicate",
      "notes": "for r in mc range: company_type_id[r]==ct_id && note.off[r]==note.off[r+1] (empty=NULL) && cn_set.test(company_id[r]); record company_id for MIN(cn.name)"
    },
    {
      "build": "cct1_set + complete_id",
      "probe": "complete_cast via movie_id offsets index",
      "type": "semi",
      "strategy": "offsets_lookup_with_compound_predicate",
      "notes": "require subject_id in cct1_set AND status_id == complete_id"
    },
    {
      "build": "mi_info_set",
      "probe": "movie_info via movie_id offsets index",
      "type": "semi",
      "strategy": "offsets_lookup_with_varlen_compare",
      "notes": "compare info varlen against 4 literals; bail on first match"
    }
  ],
  "filters": [
    {"table": "comp_cast_type", "predicate": "kind IN ('cast','crew')", "selectivity": 0.5},
    {"table": "comp_cast_type", "predicate": "kind = 'complete'", "selectivity": 0.25},
    {"table": "company_name", "predicate": "country_code != '[pl]' AND (name LIKE '%Film%' OR '%Warner%')", "selectivity": 0.08},
    {"table": "company_type", "predicate": "kind = 'production companies'", "selectivity": 0.25},
    {"table": "keyword", "predicate": "keyword = 'sequel'", "selectivity": 7.4e-6},
    {"table": "link_type", "predicate": "link LIKE '%follow%'", "selectivity": 0.3},
    {"table": "title", "predicate": "production_year = 1998", "selectivity": 0.015},
    {"table": "movie_companies", "predicate": "note IS NULL", "selectivity": 0.5},
    {"table": "movie_info", "predicate": "info IN (4 literals)", "selectivity": 0.0002}
  ],
  "data_structures": {
    "cct1_set": "small_id_array (size<=2)",
    "cn_set": "bitset(234997)",
    "lt_set": "bitset(18) + small_id_array",
    "mi_info_set": "inline literal compare",
    "title_year": "direct int32 array indexed by t_id",
    "csr_movie_keyword_keyword_id": "offsets[] + rowids[]",
    "movie_link_offsets": "int32 offsets[t_id]",
    "movie_companies_offsets": "int32 offsets[t_id]",
    "complete_cast_offsets": "int32 offsets[t_id]",
    "movie_info_offsets": "int32 offsets[t_id]"
  },
  "parallelism": {
    "strategy": "single_threaded",
    "threads": 1,
    "notes": "driver yields only ~2700 t_ids and ~40 after year filter; thread setup overhead dominates parallel gain"
  },
  "indexes": [
    {"index": "movie_keyword__keyword_id (CSR)", "purpose": "driver_range_scan"},
    {"index": "movie_link__movie_id (offsets_only)", "purpose": "join_lookup"},
    {"index": "movie_companies__movie_id (offsets_only)", "purpose": "join_lookup"},
    {"index": "complete_cast__movie_id (offsets_only)", "purpose": "join_lookup"},
    {"index": "movie_info__movie_id (offsets_only)", "purpose": "join_lookup"}
  ],
  "aggregation": "scalar_min_3_outputs",
  "output": {
    "select": [
      "MIN(cn.name) AS producing_company",
      "MIN(lt.link) AS link_type",
      "MIN(t.title) AS complete_western_sequel"
    ],
    "order_by": [],
    "limit": 1,
    "notes": "Track best (min lexicographic) cn.name, lt.link, t.title across all surviving (t_id, cn_id, lt_id) combinations. Resolve varlen strings via .off+.dat at the end (or maintain pointers + memcmp during scan)."
  },
  "execution_target": "cpp"
}
