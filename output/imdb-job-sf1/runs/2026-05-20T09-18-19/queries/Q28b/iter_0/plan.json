{
  "query_id": "Q28b",
  "pipeline": [
    "resolve_dim_ids",
    "build_dim_sets",
    "scan_title_driver",
    "probe_movie_keyword",
    "probe_complete_cast",
    "probe_movie_info_idx",
    "probe_movie_companies",
    "probe_movie_info",
    "min_aggregate"
  ],
  "dim_resolution": [
    {"name": "crew_id", "table": "comp_cast_type", "predicate": "kind = 'crew'", "scan": "linear(4 rows)"},
    {"name": "verified_id", "table": "comp_cast_type", "predicate": "kind = 'complete+verified'", "scan": "linear(4 rows)", "usage": "status_id != verified_id at probe time"},
    {"name": "us_code", "table": "company_name.country_code dict", "predicate": "lookup '[us]' in dict", "scan": "dict_linear"},
    {"name": "it1_id", "table": "info_type", "predicate": "info = 'countries'", "scan": "linear(113 rows)"},
    {"name": "it2_id", "table": "info_type", "predicate": "info = 'rating'", "scan": "linear(113 rows)"},
    {"name": "kt_set", "table": "kind_type", "predicate": "kind IN ('movie','episode')", "scan": "linear(7 rows)", "structure": "small_id_array"}
  ],
  "filters": [
    {"table": "comp_cast_type", "predicate": "kind = 'crew'", "selectivity": 0.25},
    {"table": "comp_cast_type", "predicate": "kind != 'complete+verified'", "selectivity": 0.75},
    {"table": "company_name", "predicate": "country_code != us_code", "selectivity": 0.66, "output_rows": 155000, "structure": "bitset(234997)"},
    {"table": "info_type", "predicate": "info = 'countries'", "selectivity": 0.009},
    {"table": "info_type", "predicate": "info = 'rating'", "selectivity": 0.009},
    {"table": "keyword", "predicate": "keyword IN ('murder','murder-in-title','blood','violence')", "selectivity": 3e-5, "output_rows": 4, "structure": "small_id_array(4)"},
    {"table": "kind_type", "predicate": "kind IN ('movie','episode')", "selectivity": 0.29},
    {"table": "title", "predicate": "production_year > 2005 AND kind_id ∈ kt_set", "selectivity": 0.10, "output_rows": 280000, "notes": "driver scan"},
    {"table": "movie_keyword", "predicate": "keyword_id ∈ kw_set", "selectivity": 3e-5, "output_rows": 1500, "notes": "extremely selective"},
    {"table": "complete_cast", "predicate": "subject_id == crew_id AND status_id != verified_id", "selectivity": 0.20},
    {"table": "movie_info_idx", "predicate": "info_type_id == it2_id AND lex(info) > '6.5'", "selectivity": 0.10},
    {"table": "movie_companies", "predicate": "company_id ∈ cn_set AND note NOT NULL AND !contains('(USA)') AND contains('(200')", "selectivity": 0.05},
    {"table": "movie_info", "predicate": "info_type_id == it1_id AND info IN ('Sweden','Germany','Swedish','German')", "selectivity": 0.003}
  ],
  "data_structures": {
    "kt_set": "small_id_array(≤7)",
    "cn_set": "bitset(234997)",
    "kw_set": "small_id_array(4)",
    "mi_info_literals": "small_string_array(4) with direct strcmp",
    "title_survivor_set": "bitset(2528312) OR vector<int32_t> of ~280000 ids (use bitset for O(1) membership during probes if needed, but driver pattern is sequential scan)",
    "mk_index": "offsets_only index movie_keyword__movie_id",
    "cc_index": "offsets_only index complete_cast__movie_id",
    "mi_idx_index": "offsets_only index movie_info_idx__movie_id",
    "mc_index": "offsets_only index movie_companies__movie_id",
    "mi_index": "offsets_only index movie_info__movie_id",
    "aggregation": "3 scalar MIN registers (varlen string compare via std::string_view)"
  },
  "join_order": [
    {
      "step": 1,
      "build": "kt_set (≤7 ids)",
      "probe": "title",
      "type": "semi",
      "strategy": "small_array_membership",
      "build_cardinality": 7,
      "notes": "driver scan: production_year > 2005 AND kind_id ∈ kt_set"
    },
    {
      "step": 2,
      "build": "kw_set (4 ids)",
      "probe": "movie_keyword via mk_index[t.id]",
      "type": "semi",
      "strategy": "index_nested_loop + small_array_membership",
      "build_cardinality": 4,
      "notes": "use offsets_only index; most selective probe — prune titles fast"
    },
    {
      "step": 3,
      "build": "{crew_id, verified_id}",
      "probe": "complete_cast via cc_index[t.id]",
      "type": "semi",
      "strategy": "index_nested_loop + scalar_eq",
      "build_cardinality": 2,
      "notes": "subject_id == crew_id AND status_id != verified_id"
    },
    {
      "step": 4,
      "build": "{it2_id}",
      "probe": "movie_info_idx via mi_idx_index[t.id]",
      "type": "inner",
      "strategy": "index_nested_loop + scalar_eq + lex_compare",
      "build_cardinality": 1,
      "notes": "info_type_id == it2_id AND lex(info) > '6.5'; capture min(info) candidate"
    },
    {
      "step": 5,
      "build": "cn_set bitset",
      "probe": "movie_companies via mc_index[t.id]",
      "type": "inner",
      "strategy": "index_nested_loop + bitset_test + LIKE_filter",
      "build_cardinality": 155000,
      "notes": "company_id ∈ cn_set AND note filters; capture min(cn.name) via cn lookup"
    },
    {
      "step": 6,
      "build": "{it1_id} + mi_info_literals",
      "probe": "movie_info via mi_index[t.id]",
      "type": "semi",
      "strategy": "index_nested_loop + scalar_eq + small_string_array",
      "build_cardinality": 4,
      "notes": "info_type_id == it1_id AND info ∈ 4-literals; large fact (14.8M rows) but accessed via index per surviving t.id"
    }
  ],
  "parallelism": {
    "strategy": "morsel_driven",
    "threads": "auto(nproc)",
    "morsel": "title row range",
    "merge": "thread-local MIN registers, final reduction over 3 string MINs",
    "notes": "driver loop over title parallelized; each thread maintains local min(cn_name), min(mi_idx_info), min(t_title); merge with lex min at end"
  },
  "indexes": [
    {"index": "movie_keyword__movie_id", "purpose": "join_lookup (step 2)"},
    {"index": "complete_cast__movie_id", "purpose": "join_lookup (step 3)"},
    {"index": "movie_info_idx__movie_id", "purpose": "join_lookup (step 4)"},
    {"index": "movie_companies__movie_id", "purpose": "join_lookup (step 5)"},
    {"index": "movie_info__movie_id", "purpose": "join_lookup (step 6)"}
  ],
  "aggregation": "scalar_min_x3",
  "output": {
    "order_by": [],
    "limit": 1,
    "columns": ["min_cn_name", "min_mi_idx_info", "min_t_title"]
  },
  "execution_target": "cpp",
  "notes": [
    "Probe order chosen by selectivity: mk (~3e-5) → cc (~0.20) → mi_idx (~0.10) → mc (~0.05) → mi (~0.003 with type-id) — pushing the kw semi-join first cuts titles from ~280k to ~hundreds before touching mi (14.8M).",
    "For each surviving t.id, accumulate per-t MIN candidates: cn.name from mc rows, mi_idx.info from mi_idx rows. t.title contributes once if t survives all probes.",
    "Resolve all dim ids at runtime — never hardcode dict codes."
  ]
}
