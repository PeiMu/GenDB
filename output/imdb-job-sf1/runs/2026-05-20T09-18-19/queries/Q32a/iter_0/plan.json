{
  "query_id": "Q32a",
  "pipeline": [
    "scan_keyword_resolve_kid",
    "csr_lookup_movie_keyword_by_kid",
    "for_each_t1_id_csr_lookup_movie_link",
    "dereference_t2_id_lt_id",
    "running_min_three_aggregates"
  ],
  "join_order": [
    {
      "build": "keyword(filter keyword='10,000-mile-club')",
      "probe": "movie_keyword via CSR movie_keyword__keyword_id",
      "type": "inner",
      "strategy": "csr_index_lookup",
      "build_cardinality": 1,
      "notes": "Single k_id resolved by linear scan of keyword.{off,dat} with length-16 prefilter; then direct CSR slot fetch yields mk rows (expected <<100)."
    },
    {
      "build": "mk.movie_id (t1_ids, small set)",
      "probe": "movie_link via offsets_only movie_link__movie_id",
      "type": "inner",
      "strategy": "index_nested_loop",
      "build_cardinality": 50,
      "notes": "For each t1_id, fetch ml row range; ml fan-out is small (handful per movie)."
    },
    {
      "build": "ml.linked_movie_id -> t2_id",
      "probe": "title (dense PK)",
      "type": "inner",
      "strategy": "direct_array",
      "build_cardinality": 200,
      "notes": "Dense PK: title row = t2_id - 1; no index needed."
    },
    {
      "build": "ml.link_type_id -> lt_id",
      "probe": "link_type (dense PK, 18 rows)",
      "type": "inner",
      "strategy": "direct_array",
      "build_cardinality": 18,
      "notes": "Dense PK: link_type row = lt_id - 1; trivial dereference."
    }
  ],
  "filters": [
    {
      "table": "keyword",
      "predicate": "keyword = '10,000-mile-club'",
      "selectivity": 7.45e-06,
      "notes": "Exact match; expect exactly one keyword id. Length-16 prefilter via off[i+1]-off[i] == 16."
    }
  ],
  "data_structures": {
    "keyword_filter": "linear_scan_with_length_prefilter",
    "mk_lookup": "csr_index_movie_keyword__keyword_id (offsets+rowids, mmap)",
    "ml_lookup": "offsets_only_index_movie_link__movie_id (mmap)",
    "title_t1_t2": "direct_dense_pk_array (shared title/title.{off,dat})",
    "link_type_lookup": "direct_dense_pk_array (link_type/link.{off,dat})",
    "aggregation": "three_scalar_min (lt.link, t1.title, t2.title) - lexicographic compare on varlen slices"
  },
  "parallelism": {
    "strategy": "single_threaded",
    "threads": 1,
    "notes": "Result set is tiny (≤ a few hundred ml rows after the very selective keyword filter). Threading overhead dominates."
  },
  "indexes": [
    {
      "index": "movie_keyword__keyword_id",
      "purpose": "join_lookup",
      "files": "_idx/movie_keyword__keyword_id__offsets.bin, _idx/movie_keyword__keyword_id__rowids.bin"
    },
    {
      "index": "movie_link__movie_id",
      "purpose": "join_lookup",
      "files": "_idx/movie_link__movie_id__offsets.bin (offsets_only; rowid = position)"
    }
  ],
  "aggregation": "scalar_running_min_x3",
  "output": {
    "projection": ["MIN(lt.link) AS link_type", "MIN(t1.title) AS first_movie", "MIN(t2.title) AS second_movie"],
    "order_by": [],
    "limit": null
  },
  "memory_files_to_mmap": [
    "keyword/keyword.off",
    "keyword/keyword.dat",
    "movie_keyword/movie_id.bin",
    "movie_link/linked_movie_id.bin",
    "movie_link/link_type_id.bin",
    "title/title.off",
    "title/title.dat",
    "link_type/link.off",
    "link_type/link.dat",
    "_idx/movie_keyword__keyword_id__offsets.bin",
    "_idx/movie_keyword__keyword_id__rowids.bin",
    "_idx/movie_link__movie_id__offsets.bin"
  ],
  "execution_target": "cpp"
}
