{
  "query_id": "Q29c",
  "pipeline": [
    "resolve_dim_codes",
    "build_cn_us_set",
    "drive_movies_via_keyword_csr",
    "filter_title_year",
    "probe_complete_cast",
    "probe_movie_companies_us",
    "probe_movie_info_release_like",
    "probe_cast_info_actress_voice",
    "lazy_name_gender_filter",
    "existence_aka_name",
    "existence_person_info_trivia",
    "lazy_project_chn_name",
    "aggregate_min3"
  ],
  "join_order": [
    {
      "build": "keyword(cam_kw_id)",
      "probe": "movie_keyword(via CSR keyword_id)",
      "type": "inner",
      "strategy": "csr_index_lookup",
      "build_cardinality": 1,
      "notes": "Drive from keyword='computer-animation' via movie_keyword__keyword_id CSR; expect ~few thousand candidate movies"
    },
    {
      "build": "candidate_movies",
      "probe": "title.production_year",
      "type": "semi",
      "strategy": "direct_array_lookup",
      "build_cardinality": 5000,
      "notes": "Per movie t_id, check production_year BETWEEN 2000 AND 2010"
    },
    {
      "build": "cct1_id, cct2_id",
      "probe": "complete_cast(via offsets_only on movie_id)",
      "type": "semi",
      "strategy": "index_nested_loop",
      "build_cardinality": 2,
      "notes": "Existence: any cc row with subject==cast_id AND status==verified_id"
    },
    {
      "build": "cn_us_set (~80k company ids)",
      "probe": "movie_companies(via offsets_only on movie_id)",
      "type": "semi",
      "strategy": "bitset_membership",
      "build_cardinality": 84843,
      "notes": "bitset(234997) over cn.id for company_name.country_code='[us]'"
    },
    {
      "build": "it_id (release dates)",
      "probe": "movie_info(via offsets_only on movie_id)",
      "type": "semi",
      "strategy": "index_nested_loop_with_predicate",
      "build_cardinality": 1,
      "notes": "Per-movie slice; filter info_type_id==it_id AND info LIKE 'Japan:%200%' OR 'USA:%200%' (prefix + memmem '200'); skip empty entries"
    },
    {
      "build": "actress_id + note_4_set",
      "probe": "cast_info(via offsets_only on movie_id)",
      "type": "inner",
      "strategy": "index_nested_loop_with_predicate",
      "build_cardinality": 4,
      "notes": "Per-movie slice; filter role_id==actress_id AND note ∈ {(voice),(voice: Japanese version),(voice) (uncredited),(voice: English version)}; keep person_role_id (skip NULL_INT) and person_id"
    },
    {
      "build": "f_code",
      "probe": "name(gender, name) by ci.person_id (lazy)",
      "type": "semi",
      "strategy": "direct_array_lookup_lazy",
      "build_cardinality": 1,
      "notes": "Lazy per-candidate: gender==f_code AND name contains 'An' (memmem)"
    },
    {
      "build": "person_id",
      "probe": "aka_name(via offsets_only on person_id)",
      "type": "semi",
      "strategy": "index_existence_check",
      "build_cardinality": 1,
      "notes": "off[p+1]>off[p]"
    },
    {
      "build": "it3_id (trivia)",
      "probe": "person_info(via offsets_only on person_id)",
      "type": "semi",
      "strategy": "index_nested_loop_with_predicate",
      "build_cardinality": 1,
      "notes": "Per-person slice; existence of any pi row with info_type_id==it3_id"
    },
    {
      "build": "person_role_id",
      "probe": "char_name.name",
      "type": "inner",
      "strategy": "direct_array_lookup_lazy",
      "build_cardinality": 1,
      "notes": "Lazy fetch chn.name only for surviving rows, for MIN(chn.name)"
    }
  ],
  "filters": [
    {"table": "comp_cast_type", "predicate": "kind='cast'", "selectivity": 0.25},
    {"table": "comp_cast_type", "predicate": "kind='complete+verified'", "selectivity": 0.25},
    {"table": "info_type", "predicate": "info='release dates'", "selectivity": 0.009},
    {"table": "info_type", "predicate": "info='trivia'", "selectivity": 0.009},
    {"table": "keyword", "predicate": "keyword='computer-animation'", "selectivity": 7.5e-6},
    {"table": "role_type", "predicate": "role='actress'", "selectivity": 0.083},
    {"table": "company_name", "predicate": "country_code='[us]'", "selectivity": 0.36},
    {"table": "name", "predicate": "gender='f' AND name LIKE '%An%'", "selectivity": 0.10},
    {"table": "title", "predicate": "production_year BETWEEN 2000 AND 2010", "selectivity": 0.20},
    {"table": "movie_info", "predicate": "info_type_id=it_id AND (info LIKE 'Japan:%200%' OR 'USA:%200%') AND info NOT NULL", "selectivity": 0.005},
    {"table": "cast_info", "predicate": "role_id=actress_id AND note IN 4-set AND person_role_id IS NOT NULL", "selectivity": 0.005}
  ],
  "data_structures": {
    "dim_codes": "scalar_ids (cct1_cast_id, cct2_verified_id, it_id, it3_id, cam_kw_id, actress_id, f_code, us_code)",
    "cn_us_set": "bitset(234997) over cn.id where country_code='[us]'",
    "ci_note_set": "tiny_array<string_view,4> + per-row equality scan (or pre-built 4-way length-bucketed compare)",
    "candidate_movies": "stream from CSR (no materialization)",
    "person_seen_set": "absl::flat_hash_set<int32> (dedupe persons across ci rows; small)",
    "aggregation": "scalar MIN over 3 string columns (chn.name, n.name, t.title) via lazy offset+memcmp comparison"
  },
  "parallelism": {
    "strategy": "morsel_driven over CSR(cam_kw_id) movie range",
    "threads": "auto(nproc)",
    "notes": "Partition rowids[lo..hi) of movie_keyword CSR into morsels; each thread accumulates 3 local MIN strings; merge at end."
  },
  "indexes": [
    {"index": "movie_keyword__keyword_id", "purpose": "drive_movies_from_keyword"},
    {"index": "complete_cast__movie_id", "purpose": "per_movie_cc_slice"},
    {"index": "movie_companies__movie_id", "purpose": "per_movie_mc_slice"},
    {"index": "movie_info__movie_id", "purpose": "per_movie_mi_slice"},
    {"index": "cast_info__movie_id", "purpose": "per_movie_ci_slice"},
    {"index": "aka_name__person_id", "purpose": "existence_check"},
    {"index": "person_info__person_id", "purpose": "per_person_pi_slice_trivia_existence"}
  ],
  "aggregation": "scalar_min_3_strings",
  "output": {"order_by": [], "limit": 1, "projection": ["MIN(chn.name)", "MIN(n.name)", "MIN(t.title)"]},
  "execution_target": "cpp"
}
