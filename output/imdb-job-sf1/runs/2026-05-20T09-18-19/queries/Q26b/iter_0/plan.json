{
  "query_id": "Q26b",
  "pipeline": [
    "build_dim_sets",
    "scan_title_filter(year>2005, kind_id==movie)",
    "probe_movie_keyword(kw_set)",
    "probe_complete_cast(cct1_id, cct2_set)",
    "probe_movie_info_idx(it2_id, info>'8.0')",
    "probe_cast_info(chn_set)",
    "aggregate_min"
  ],
  "filters": [
    {"table": "comp_cast_type", "predicate": "kind == 'cast'", "selectivity": 0.25, "notes": "resolves single cct1_id"},
    {"table": "comp_cast_type", "predicate": "kind LIKE '%complete%'", "selectivity": 0.5, "notes": "small int set (likely 1-2 ids)"},
    {"table": "info_type", "predicate": "info == 'rating'", "selectivity": 0.009, "notes": "resolves single it2_id"},
    {"table": "kind_type", "predicate": "kind == 'movie'", "selectivity": 0.14, "notes": "resolves single movie_kind_id"},
    {"table": "keyword", "predicate": "keyword IN (4 vals)", "selectivity": 3.0e-5, "notes": "kw_set size = 4"},
    {"table": "char_name", "predicate": "name NOT NULL AND (name LIKE '%man%' OR name LIKE '%Man%')", "selectivity": 0.03, "notes": "memmem on .dat via .off ranges; ~94k ids"},
    {"table": "title", "predicate": "production_year > 2005 AND kind_id == movie_kind_id", "selectivity": 0.25, "notes": "driver filter"},
    {"table": "movie_info_idx", "predicate": "info_type_id == it2_id AND string_view(info) > '8.0'", "selectivity": 0.05, "notes": "applied during probe"}
  ],
  "join_order": [
    {
      "build": "comp_cast_type(kind=='cast')",
      "probe": "scalar",
      "type": "scalar_lookup",
      "strategy": "scan_and_match",
      "build_cardinality": 1,
      "notes": "Single int32 cct1_id"
    },
    {
      "build": "comp_cast_type(kind LIKE '%complete%')",
      "probe": "scalar_set",
      "type": "scalar_lookup",
      "strategy": "scan_and_match",
      "build_cardinality": 2,
      "notes": "Small int set cct2_set (bitset of 4 slots)"
    },
    {
      "build": "info_type(info=='rating')",
      "probe": "scalar",
      "type": "scalar_lookup",
      "strategy": "scan_and_match",
      "build_cardinality": 1
    },
    {
      "build": "kind_type(kind=='movie')",
      "probe": "scalar",
      "type": "scalar_lookup",
      "strategy": "scan_and_match",
      "build_cardinality": 1
    },
    {
      "build": "keyword(IN 4)",
      "probe": "movie_keyword.keyword_id",
      "type": "semi",
      "strategy": "flat_array_membership",
      "build_cardinality": 4,
      "notes": "4-element int32 array; linear scan or unrolled check faster than hash"
    },
    {
      "build": "char_name(name LIKE '%man%|%Man%' AND NOT NULL)",
      "probe": "cast_info.person_role_id",
      "type": "semi",
      "strategy": "bitset",
      "build_cardinality": 94000,
      "notes": "bitset over 3140339 ids; O(1) membership; built once parallel"
    },
    {
      "build": "title(year>2005, kind_id==movie)",
      "probe": "driver_scan",
      "type": "driver",
      "strategy": "parallel_scan",
      "build_cardinality": 630000,
      "notes": "Driver loop; emit t_id for each matching title; parallelized morsel"
    },
    {
      "build": "title_id",
      "probe": "movie_keyword via offsets index",
      "type": "semi",
      "strategy": "index_nested_loop + kw_set_check",
      "build_cardinality": 1,
      "notes": "per-t probe; very selective ~0.02% rows match any of 4 keywords; emit first match"
    },
    {
      "build": "title_id",
      "probe": "complete_cast via offsets index",
      "type": "semi",
      "strategy": "index_nested_loop + subject==cct1 + status in cct2_set",
      "build_cardinality": 1,
      "notes": "per-t probe with offsets index; ~135k total cc rows"
    },
    {
      "build": "title_id",
      "probe": "movie_info_idx via offsets index",
      "type": "inner",
      "strategy": "index_nested_loop + info_type+value check",
      "build_cardinality": 1,
      "notes": "per-t probe; filter info_type_id==it2_id AND info>'8.0'; project rating string"
    },
    {
      "build": "chn_set bitset",
      "probe": "cast_info via offsets index",
      "type": "semi",
      "strategy": "index_nested_loop + bitset_lookup",
      "build_cardinality": 94000,
      "notes": "per-t probe of cast_info; skip NULL_INT person_role_id; bitset[chn_id] check; emit MIN(chn.name)"
    }
  ],
  "data_structures": {
    "cct1_id": "int32 scalar",
    "cct2_set": "small int32 array (size<=4) checked by direct compare",
    "it2_id": "int32 scalar",
    "movie_kind_id": "int32 scalar",
    "kw_set": "flat int32 array (size=4) for unrolled membership test",
    "chn_set": "bitset(3140352 bits, ~393KB) over char_name ids",
    "indexes": "preloaded offsets arrays (length 2528314 int32 each) for cc, mi_idx, mk, ci",
    "title_driver": "sequential int32 scan with branchless year+kind filter",
    "aggregation": "3 scalar MIN buffers per-thread (string_view char_name, string_view info, string_view title) merged at end"
  },
  "parallelism": {
    "strategy": "morsel_driven over title id ranges",
    "threads": "auto(nproc)",
    "morsel_size": 65536,
    "notes": "12 cores; each thread maintains local 3-way MIN strings; reduce at end"
  },
  "indexes": [
    {"index": "movie_keyword__movie_id offsets", "purpose": "per-t mk row range"},
    {"index": "complete_cast__movie_id offsets", "purpose": "per-t cc row range"},
    {"index": "movie_info_idx__movie_id offsets", "purpose": "per-t mi_idx row range"},
    {"index": "cast_info__movie_id offsets", "purpose": "per-t ci row range"}
  ],
  "aggregation": "scalar_min (3 string_view fields, no grouping)",
  "probe_order_rationale": "mk first (kw_set IN 4 is the most selective ~0.02% per movie), then cc (semi-join cuts most non-complete movies), then mi_idx (filters by rating>'8.0', also projects rating), then ci with chn_set bitset (largest table; only touched if all prior matched).",
  "output": {"order_by": [], "limit": null, "projection": ["MIN(chn.name) AS character_name", "MIN(mi_idx.info) AS rating", "MIN(t.title) AS complete_hero_movie"]},
  "execution_target": "cpp"
}
