{
  "query_id": "Q31b",
  "pipeline": [
    "resolve_dim_literals",
    "scan_title_driver",
    "probe_fact_csrs_per_title",
    "join_dimensions",
    "aggregate_min"
  ],
  "dimension_literal_resolution": [
    {
      "dim": "info_type",
      "literal": "genres",
      "out_var": "it1_id",
      "method": "scan info_type/info.* + read info_type/id.bin at match",
      "notes": "small dim (113 rows); single pass"
    },
    {
      "dim": "info_type",
      "literal": "votes",
      "out_var": "it2_id",
      "method": "scan info_type/info.* + read info_type/id.bin at match"
    },
    {
      "dim": "keyword",
      "literals": ["murder", "violence", "blood", "gore", "death", "female-nudity", "hospital"],
      "out_var": "k_id_set",
      "method": "scan keyword/keyword.* into std::unordered_set<int32_t> of ids",
      "expected_size": 7
    },
    {
      "dim": "company_name",
      "predicate": "name LIKE 'Lionsgate%'",
      "out_var": "cn_id_set",
      "method": "scan company_name/name.* with memcmp prefix; collect matching ids into std::unordered_set<int32_t>",
      "expected_size": "~5-30"
    }
  ],
  "driver": {
    "table": "title",
    "scan": "sequential rows 0..N_title",
    "early_filters": [
      {"predicate": "production_year > 2000", "selectivity": 0.55},
      {"predicate": "title LIKE '%Freddy%' OR title LIKE '%Jason%' OR title LIKE 'Saw%'", "selectivity": 0.00015, "notes": "very selective; use memmem for substrings, memcmp prefix for 'Saw%'"}
    ],
    "estimated_surviving_titles": "~200-600"
  },
  "join_order": [
    {
      "step": 1,
      "build": "title (filtered by production_year + title pattern)",
      "probe": "all fact tables via primary CSR on movie_id",
      "type": "inner",
      "strategy": "for each surviving title.id v, lookup [off[v], off[v+1]) per fact CSR",
      "build_cardinality": 400
    },
    {
      "step": 2,
      "fact": "movie_keyword",
      "csr": "movie_keyword__movie_id",
      "filter": "k_id_set.contains(mk.keyword_id)",
      "type": "semi",
      "strategy": "primary_csr_range_scan; reject title if no row passes",
      "notes": "cheap semi-join filter applied first on each title"
    },
    {
      "step": 3,
      "fact": "movie_companies",
      "csr": "movie_companies__movie_id",
      "filters": [
        "cn_id_set.contains(mc.company_id)",
        "mc.note LIKE '%(Blu-ray)%' via memmem"
      ],
      "type": "semi",
      "strategy": "primary_csr_range_scan; if no row passes, drop title",
      "notes": "highly selective company + note filter"
    },
    {
      "step": 4,
      "fact": "movie_info",
      "csr": "movie_info__movie_id",
      "filters": [
        "mi.info_type_id == it1_id",
        "mi.info IN ('Horror','Thriller') via std::unordered_set<string_view>"
      ],
      "type": "semi+project",
      "strategy": "primary_csr_range_scan; track MIN(mi.info) candidate (string) only over surviving rows",
      "notes": "info_type_id filter using direct equality on resolved literal id"
    },
    {
      "step": 5,
      "fact": "movie_info_idx",
      "csr": "movie_info_idx__movie_id",
      "filters": [
        "mi_idx.info_type_id == it2_id"
      ],
      "type": "semi+project",
      "strategy": "primary_csr_range_scan; track MIN(mi_idx.info)"
    },
    {
      "step": 6,
      "fact": "cast_info",
      "csr": "cast_info__movie_id",
      "filters": [
        "ci.note IN ('(writer)','(head writer)','(written by)','(story)','(story editor)')"
      ],
      "type": "inner",
      "strategy": "primary_csr_range_scan; for each surviving ci row, look up name via name__id__pos[ci.person_id] then test n.gender == 'm'; if pass, read name/name.* and update MIN(n.name)"
    },
    {
      "step": 7,
      "name_lookup": {
        "dim": "name",
        "index": "name__id__pos",
        "filter": "name/gender.bin[row] == 'm'",
        "project": "MIN(n.name) varlen via name/name.offsets+data"
      }
    }
  ],
  "filters": [
    {"table": "title", "predicate": "production_year > 2000", "selectivity": 0.55},
    {"table": "title", "predicate": "title LIKE Freddy/Jason/Saw", "selectivity": 0.00015},
    {"table": "cast_info", "predicate": "note IN writer-set", "selectivity": 0.02},
    {"table": "company_name", "predicate": "name LIKE 'Lionsgate%'", "selectivity": 0.00005},
    {"table": "info_type", "predicate": "info='genres'", "resolves_to": "single id"},
    {"table": "info_type", "predicate": "info='votes'", "resolves_to": "single id"},
    {"table": "keyword", "predicate": "keyword IN 7-set", "resolves_to": "id set"},
    {"table": "movie_companies", "predicate": "note LIKE '%(Blu-ray)%'", "selectivity": 0.005},
    {"table": "movie_info", "predicate": "info IN ('Horror','Thriller')", "selectivity": 0.005},
    {"table": "movie_info_idx", "predicate": "(via it2_id only)"},
    {"table": "name", "predicate": "gender='m'", "selectivity": 0.55}
  ],
  "data_structures": {
    "it1_id": "int32_t scalar",
    "it2_id": "int32_t scalar",
    "k_id_set": "std::unordered_set<int32_t> (size ~7)",
    "cn_id_set": "std::unordered_set<int32_t> (size small)",
    "ci_note_set": "std::unordered_set<std::string_view> of 5 literals",
    "mi_info_set": "std::unordered_set<std::string_view> of {Horror, Thriller}",
    "title_title_patterns": "vector<{kind, literal}> for {%Freddy%, %Jason%, Saw%}",
    "agg_min": "4 std::string holding running mins (compare with std::string_view); initialized empty/unset flag"
  },
  "indexes": [
    {"index": "indexes/title__id__pos.bin", "purpose": "not strictly needed (title is driver, sequential)"},
    {"index": "indexes/movie_info__movie_id__offsets.bin", "purpose": "range scan per title"},
    {"index": "indexes/movie_info_idx__movie_id__offsets.bin", "purpose": "range scan per title"},
    {"index": "indexes/movie_keyword__movie_id__offsets.bin", "purpose": "range scan per title (semi)"},
    {"index": "indexes/movie_companies__movie_id__offsets.bin", "purpose": "range scan per title (semi)"},
    {"index": "indexes/cast_info__movie_id__offsets.bin", "purpose": "range scan per title"},
    {"index": "indexes/name__id__pos.bin", "purpose": "lookup gender + name from ci.person_id"}
  ],
  "parallelism": {
    "strategy": "morsel_driven over title rows",
    "morsel_size": 16384,
    "threads": "auto(nproc)=12",
    "reduction": "per-thread local 4-tuple of MIN strings; final merge takes lex-min across threads"
  },
  "aggregation": "scalar_min_4cols",
  "output": {
    "projections": [
      "MIN(mi.info) AS movie_budget",
      "MIN(mi_idx.info) AS movie_votes",
      "MIN(n.name) AS writer",
      "MIN(t.title) AS violent_liongate_movie"
    ],
    "order_by": [],
    "limit": 1,
    "row_count": 1,
    "notes": "Single-row aggregate; print 4 MIN values (or empty/NULL if no match)"
  },
  "execution_target": "cpp"
}
