{
  "query_id": "Q25b",
  "pipeline": [
    "resolve_dims",
    "build_valid_persons_bitset",
    "scan_title_driver_filtered",
    "per_survivor_fact_probes",
    "aggregate_min"
  ],
  "dim_resolution": [
    {
      "step": "info_type_scan",
      "table": "info_type",
      "outputs": ["it1_id (info='genres')", "it2_id (info='votes')"],
      "strategy": "single_pass_scan",
      "cardinality": 113
    },
    {
      "step": "keyword_scan",
      "table": "keyword",
      "outputs": ["kw_ids (3 ids from IN-set)"],
      "strategy": "single_pass_scan_collect_into_small_sorted_array",
      "cardinality": 134170
    },
    {
      "step": "gender_dict_resolve",
      "table": "name",
      "outputs": ["m_code (dict code for 'm')"],
      "strategy": "dict_lookup_in_gender.dict"
    },
    {
      "step": "build_valid_persons",
      "table": "name",
      "outputs": ["valid_persons: bitset(4167491)"],
      "strategy": "parallel_scan_gender_codes_equal_to_m_code",
      "cardinality_in": 4167491,
      "selectivity": 0.55,
      "notes": "Bit set on (id-1) when gender code == m_code"
    }
  ],
  "filters": [
    {"table": "title", "predicate": "production_year > 2010", "selectivity": 0.25},
    {"table": "title", "predicate": "title LIKE 'Vampire%' (multi-byte memcmp on first 7 bytes)", "selectivity": 0.00005, "notes": "Parameterized: prefix length varies; read first N bytes of title.dat at title.off[v-1]; skip empty/NULL titles"},
    {"table": "name", "predicate": "gender = 'm'", "selectivity": 0.55},
    {"table": "cast_info", "predicate": "note IN writer-set (5 values)", "selectivity": 0.04},
    {"table": "movie_info", "predicate": "info_type_id == it1_id AND info IN 6-set (Q25b)", "selectivity": 0.01},
    {"table": "movie_info_idx", "predicate": "info_type_id == it2_id", "selectivity": 0.5},
    {"table": "movie_keyword", "predicate": "keyword_id IN kw_ids (3 ids)", "selectivity": 0.00002}
  ],
  "join_order": [
    {
      "build": "title(filtered: year>2010 AND title prefix match)",
      "probe": "movie_keyword via offsets_only(movie_keyword__movie_id)",
      "type": "semi",
      "strategy": "index_nested_loop_with_small_array_membership",
      "build_cardinality": 130,
      "notes": "Cheapest fact probe first: kw_ids has 3 entries — linear scan or sorted-3 membership check. Most title survivors die here."
    },
    {
      "build": "title∩mk_survivors",
      "probe": "movie_info_idx via offsets_only(movie_info_idx__movie_id)",
      "type": "semi",
      "strategy": "index_nested_loop_filter_info_type_id_eq_it2_id",
      "build_cardinality": 30,
      "notes": "Project mi_idx.info for MIN agg while scanning matched rows"
    },
    {
      "build": "title∩mk∩mi_idx",
      "probe": "movie_info via offsets_only(movie_info__movie_id)",
      "type": "semi",
      "strategy": "index_nested_loop_filter_info_type_id_eq_it1_id_AND_info_in_set",
      "build_cardinality": 20,
      "notes": "Project mi.info for MIN agg. info IN-set membership via small hash_set or sorted-array"
    },
    {
      "build": "title∩mk∩mi_idx∩mi",
      "probe": "cast_info via offsets_only(cast_info__movie_id)",
      "type": "inner",
      "strategy": "index_nested_loop_filter_note_in_writerset_AND_valid_persons[person_id-1]",
      "build_cardinality": 10,
      "notes": "Apply note IN-set then bitset test; on success fetch n.name via direct index for MIN agg"
    }
  ],
  "data_structures": {
    "it1_id": "int32 scalar",
    "it2_id": "int32 scalar",
    "kw_ids": "sorted int32[3] (linear scan membership)",
    "m_code": "int8/int16 dict code",
    "valid_persons": "bitset(4167491) ~512KB",
    "writer_notes": "small flat_array<string_view>[5] with first-byte hash or linear strcmp",
    "mi_info_set": "small sorted_array<string_view>[6] (Q25b template) — implement as generic IN-set membership",
    "title_prefix": "const byte[] prefix from parameter; memcmp first N bytes",
    "aggregation": "4 scalar MIN slots: (mi_info_min, mi_idx_info_min, n_name_min, t_title_min) as std::string"
  },
  "parallelism": {
    "strategy": "morsel_driven_over_title_driver",
    "threads": "auto(nproc)",
    "morsel_size": 100000,
    "notes": "Each thread maintains thread-local 4 MIN strings; final reduction across threads. valid_persons bitset built in parallel before driver phase."
  },
  "indexes": [
    {"index": "movie_keyword__movie_id (offsets_only)", "purpose": "join_lookup"},
    {"index": "movie_info_idx__movie_id (offsets_only)", "purpose": "join_lookup"},
    {"index": "movie_info__movie_id (offsets_only)", "purpose": "join_lookup"},
    {"index": "cast_info__movie_id (offsets_only)", "purpose": "join_lookup"},
    {"index": "name.id dense-PK direct (id-1)", "purpose": "person_id -> gender/name fetch"}
  ],
  "aggregation": "scalar_min_4_slots",
  "output": {"order_by": [], "limit": 1, "projection": ["MIN(mi.info)", "MIN(mi_idx.info)", "MIN(n.name)", "MIN(t.title)"]},
  "execution_target": "cpp"
}
