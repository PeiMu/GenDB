{
  "query_id": "Q11a",
  "pipeline": [
    "resolve_dims",
    "filter_company_name",
    "expand_mc_via_company_id_csr",
    "filter_mc_note_and_ct",
    "filter_title_year",
    "semi_join_movie_keyword",
    "semi_join_movie_link_collect_lt",
    "aggregate_min"
  ],
  "join_order": [
    {
      "build": "company_name(filtered: country_code!=pl AND name LIKE %Film%/%Warner%)",
      "probe": "movie_companies via movie_companies__company_id CSR",
      "type": "inner",
      "strategy": "index_nested_loop",
      "build_cardinality": 5000,
      "notes": "Driver: filtered cn_ids expanded through CSR index to mc rows; apply note IS NULL and company_type_id == ct_id inline"
    },
    {
      "build": "title (lookup per mid)",
      "probe": "mc.movie_id stream",
      "type": "inner",
      "strategy": "direct_array",
      "build_cardinality": 2528312,
      "notes": "title.id is dense PK; row = mid-1; apply production_year BETWEEN 1950 AND 2000 (skip INT32_MIN)"
    },
    {
      "build": "keyword_id for 'sequel' (single id)",
      "probe": "movie_keyword via movie_keyword__movie_id offsets_only",
      "type": "semi",
      "strategy": "index_nested_loop",
      "build_cardinality": 1,
      "notes": "For each candidate mid, scan [off[mid], off[mid+1]) for keyword_id == k_id"
    },
    {
      "build": "LT set (link_type ids matching %follow%)",
      "probe": "movie_link via movie_link__movie_id offsets_only",
      "type": "semi",
      "strategy": "index_nested_loop",
      "build_cardinality": 18,
      "notes": "For each candidate mid, scan [off[mid], off[mid+1]) and check link_type_id in LT; capture matching ml row for lt.link MIN"
    }
  ],
  "filters": [
    {"table": "company_name", "predicate": "country_code != '[pl]' AND country_code != 0", "selectivity": 0.99},
    {"table": "company_name", "predicate": "name LIKE '%Film%' OR name LIKE '%Warner%'", "selectivity": 0.02},
    {"table": "company_type", "predicate": "kind = 'production companies'", "selectivity": 0.25},
    {"table": "keyword", "predicate": "keyword = 'sequel'", "selectivity": 7.45e-06},
    {"table": "link_type", "predicate": "link LIKE '%follow%'", "selectivity": 0.3},
    {"table": "movie_companies", "predicate": "note IS NULL", "selectivity": 0.6},
    {"table": "movie_companies", "predicate": "company_type_id == ct_id", "selectivity": 0.5},
    {"table": "title", "predicate": "production_year BETWEEN 1950 AND 2000", "selectivity": 0.55}
  ],
  "data_structures": {
    "pl_code": "int16 scalar resolved at startup",
    "ct_id": "int32 scalar resolved at startup",
    "k_id": "int32 scalar resolved at startup",
    "lt_set": "flat_array<int32> (≤18 entries) + small map link_type_id -> string_view link for MIN",
    "cn_ids": "flat_array<int32> (filtered company_name ids)",
    "cn_name_lookup": "implicit (string_view via off/dat on demand for MIN)",
    "aggregation": "three string_view min trackers (cn.name, lt.link, t.title)"
  },
  "parallelism": {
    "strategy": "morsel_driven",
    "threads": "auto(nproc)",
    "notes": "Parallelize over filtered cn_ids; each thread maintains thread-local min tracker (length-prefixed lex compare), merged at end"
  },
  "indexes": [
    {"index": "movie_companies__company_id", "purpose": "expand cn_id -> mc rows (CSR)"},
    {"index": "movie_keyword__movie_id", "purpose": "semi-join probe by movie_id (offsets_only)"},
    {"index": "movie_link__movie_id", "purpose": "semi-join probe by movie_id (offsets_only)"}
  ],
  "aggregation": "scalar_min_trackers",
  "output": {"order_by": [], "limit": 1},
  "execution_target": "cpp"
}
