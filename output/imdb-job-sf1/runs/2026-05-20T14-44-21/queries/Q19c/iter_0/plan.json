{
  "query_id": "Q19c",
  "pipeline": [
    "resolve_dims",
    "scan_mi_via_info_type_csr",
    "filter_mi_info_like",
    "filter_title_year",
    "probe_mc_cn_us",
    "probe_ci_voice_actress",
    "filter_name_gender_like",
    "require_aka_name_nonempty",
    "require_person_role_present",
    "aggregate_min"
  ],
  "join_order": [
    {
      "build": "info_type(it_rd='release dates')",
      "probe": "movie_info via movie_info__info_type_id CSR",
      "type": "semi",
      "strategy": "index_nested_loop",
      "build_cardinality": 1,
      "notes": "Walk only the it_rd slice of mi (CSR offsets)."
    },
    {
      "build": "mi rows passing LIKE 'Japan:%200%' OR 'USA:%200%'",
      "probe": "title (dense-PK)",
      "type": "inner",
      "strategy": "direct_array",
      "build_cardinality": 50000,
      "notes": "title.id is dense-PK; lookup by movie_id-1 to apply production_year > 2000."
    },
    {
      "build": "set of qualifying movie_ids T",
      "probe": "movie_companies via mc__movie_id offsets",
      "type": "semi",
      "strategy": "index_nested_loop",
      "build_cardinality": 30000,
      "notes": "For each mv, walk mc range; check cn_country_code[company_id-1]==cc_us."
    },
    {
      "build": "qualifying movie_ids T",
      "probe": "cast_info via ci__movie_id offsets",
      "type": "inner",
      "strategy": "index_nested_loop",
      "build_cardinality": 30000,
      "notes": "For each mv, walk ci range; apply note IN voice-set, role_id==rt_actress, person_role_id present."
    },
    {
      "build": "name(gender='f' AND name LIKE '%An%') as bitset over n.id",
      "probe": "ci.person_id",
      "type": "semi",
      "strategy": "bitset_lookup",
      "build_cardinality": 600000,
      "notes": "Lazy probe: check n_gender[pid-1]==g_f, then memmem name for 'An'."
    },
    {
      "build": "aka_name__person_id offsets",
      "probe": "person_id from ci row",
      "type": "semi",
      "strategy": "index_nested_loop",
      "build_cardinality": 0,
      "notes": "Require an_off[pid+1] > an_off[pid] (non-empty range)."
    }
  ],
  "filters": [
    {"table": "role_type", "predicate": "role='actress'", "selectivity": 0.083},
    {"table": "info_type", "predicate": "info='release dates'", "selectivity": 0.0088},
    {"table": "company_name", "predicate": "country_code='[us]'", "selectivity": 0.5},
    {"table": "name", "predicate": "gender='f'", "selectivity": 0.32},
    {"table": "name", "predicate": "name LIKE '%An%'", "selectivity": 0.45},
    {"table": "movie_info", "predicate": "info_type_id=it_rd AND (info LIKE 'Japan:%200%' OR info LIKE 'USA:%200%')", "selectivity": 0.005},
    {"table": "title", "predicate": "production_year > 2000", "selectivity": 0.45},
    {"table": "cast_info", "predicate": "note IN voice-set AND role_id=rt_actress", "selectivity": 0.003}
  ],
  "data_structures": {
    "dim_scalars": "int32 ids for rt_actress, it_rd, cc_us, g_f",
    "cn_country_code_lookup": "int32 array[cn_rows] (country_code id per company)",
    "n_gender_lookup": "int8 array[name_rows] (gender id per name)",
    "n_name_lookup": "varlen accessor (offsets+bytes) over name.name",
    "ci_note_voice_set": "flat_hash_set<string_view> of 4 voice strings",
    "movie_set_T": "vector<int32_t> of qualifying movie_ids",
    "title_year": "int32 array (dense-PK) for production_year",
    "mi_info_type_csr": "offsets[114]+rowids[14835720] read from disk",
    "ci_movie_offsets": "int32 offsets array",
    "mc_movie_offsets": "int32 offsets array",
    "an_person_offsets": "int32 offsets array",
    "aggregation": "two scalar MIN accumulators (string_view) — n.name and t.title"
  },
  "parallelism": {
    "strategy": "morsel_driven",
    "threads": "auto(nproc)",
    "morsel_unit": "chunks of mi rowids from it_rd CSR slice (e.g., 4096 rows per task); per-thread local MIN, final reduce across threads"
  },
  "indexes": [
    {"index": "movie_info__info_type_id (CSR)", "purpose": "drive scan: iterate only release-dates mi rows"},
    {"index": "cast_info__movie_id (offsets_only)", "purpose": "join_lookup ci rows by movie_id"},
    {"index": "movie_companies__movie_id (offsets_only)", "purpose": "join_lookup mc rows by movie_id"},
    {"index": "aka_name__person_id (offsets_only)", "purpose": "semi-join existence check"}
  ],
  "like_strategies": [
    {"column": "mi.info", "patterns": ["Japan:%200%", "USA:%200%"], "method": "prefix_check (memcmp 'Japan:' or 'USA:') then memmem for '200' in remainder"},
    {"column": "n.name", "pattern": "%An%", "method": "length-pruned memmem"}
  ],
  "aggregation": "scalar_min_two_columns",
  "output": {"order_by": [], "limit": 1, "projection": ["MIN(n.name)", "MIN(t.title)"]},
  "execution_target": "cpp"
}
