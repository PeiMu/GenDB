{
  "query_id": "Q31b",
  "pipeline": [
    "resolve_info_type_ids",
    "scan_company_name_lionsgate",
    "scan_keyword_in_set",
    "scan_title_filter_driver",
    "probe_movie_companies_blu_ray_lionsgate",
    "probe_movie_keyword_in_kids",
    "probe_movie_info_genres_horror_thriller",
    "probe_movie_info_idx_votes",
    "probe_cast_info_writer_notes",
    "lookup_name_gender_m",
    "aggregate_min"
  ],
  "join_order": [
    {
      "build": "title(filtered: year>2000 AND title LIKE %Freddy%|%Jason%|Saw%)",
      "probe": "title->mv_set",
      "type": "inner",
      "strategy": "scan_filter",
      "build_cardinality": 200,
      "notes": "Driver. ~hundreds of movie_ids. Substring memmem for Freddy/Jason; prefix memcmp Saw."
    },
    {
      "build": "company_name(filtered: name LIKE 'Lionsgate%')",
      "probe": "movie_companies via offsets_only on movie_id",
      "type": "semi",
      "strategy": "hash_set",
      "build_cardinality": 30,
      "notes": "cn_ids small (~tens). Use hash_set<int32> for company_id membership during mc probe."
    },
    {
      "build": "keyword(filtered: keyword IN 7-set)",
      "probe": "movie_keyword via offsets_only on movie_id",
      "type": "semi",
      "strategy": "hash_set",
      "build_cardinality": 7,
      "notes": "k_ids ~7. Use flat_array or hash_set for keyword_id membership."
    },
    {
      "build": "info_type(filtered: info='genres')",
      "probe": "movie_info via offsets_only on movie_id",
      "type": "semi",
      "strategy": "scalar_compare",
      "build_cardinality": 1,
      "notes": "it1_id single int32. Filter mi rows by info_type_id==it1_id then info IN {'Horror','Thriller'}."
    },
    {
      "build": "info_type(filtered: info='votes')",
      "probe": "movie_info_idx via offsets_only on movie_id",
      "type": "semi",
      "strategy": "scalar_compare",
      "build_cardinality": 1,
      "notes": "it2_id single int32."
    },
    {
      "build": "mv_set (qualifying title.id)",
      "probe": "movie_companies offsets_only[mv]",
      "type": "semi",
      "strategy": "index_nested_loop",
      "build_cardinality": 200,
      "notes": "Per mv: scan mc range, require company_id in cn_ids AND note memmem '(Blu-ray)' (len>=9)."
    },
    {
      "build": "mv_set (post mc filter)",
      "probe": "movie_keyword offsets_only[mv]",
      "type": "semi",
      "strategy": "index_nested_loop",
      "build_cardinality": 100,
      "notes": "Per mv: scan mk range, require keyword_id in k_ids."
    },
    {
      "build": "mv_set (post mk filter)",
      "probe": "movie_info offsets_only[mv]",
      "type": "inner",
      "strategy": "index_nested_loop",
      "build_cardinality": 80,
      "notes": "Per mv: find row where info_type_id==it1_id AND info IN {Horror,Thriller}; capture info for MIN."
    },
    {
      "build": "mv_set (post mi filter)",
      "probe": "movie_info_idx offsets_only[mv]",
      "type": "inner",
      "strategy": "index_nested_loop",
      "build_cardinality": 50,
      "notes": "Per mv: find row where info_type_id==it2_id; capture info for MIN."
    },
    {
      "build": "mv_set (post mi_idx filter)",
      "probe": "cast_info offsets_only[mv]",
      "type": "inner",
      "strategy": "index_nested_loop",
      "build_cardinality": 50,
      "notes": "Per mv: scan ci range, filter ci.note IN 5-set (interned to 5 offset/len literals); then check name.gender[person_id]=='m'; capture name for MIN."
    },
    {
      "build": "name (gender lookup)",
      "probe": "ci.person_id",
      "type": "inner",
      "strategy": "direct_array",
      "build_cardinality": 4167491,
      "notes": "name.gender.bin is u8 dict-coded; resolve 'm' code from gender.dict at startup; direct array lookup."
    }
  ],
  "filters": [
    {"table": "company_name", "predicate": "name LIKE 'Lionsgate%'", "selectivity": 0.00015, "method": "memcmp first 9 bytes"},
    {"table": "info_type", "predicate": "info='genres'", "selectivity": 0.009, "method": "equality scan"},
    {"table": "info_type", "predicate": "info='votes'", "selectivity": 0.009, "method": "equality scan"},
    {"table": "keyword", "predicate": "keyword IN 7-set", "selectivity": 0.00005, "method": "literal eq fan-out"},
    {"table": "title", "predicate": "production_year>2000 AND (title LIKE %Freddy%|%Jason%|Saw%)", "selectivity": 0.0001, "method": "scan: year prefilter then memmem/memcmp"},
    {"table": "movie_companies", "predicate": "note LIKE '%(Blu-ray)%'", "selectivity": 0.005, "method": "memmem, length prefilter >=9"},
    {"table": "movie_info", "predicate": "info_type_id=it1_id AND info IN {Horror,Thriller}", "selectivity": 0.01, "method": "int eq then string-literal compare"},
    {"table": "movie_info_idx", "predicate": "info_type_id=it2_id", "selectivity": 0.07, "method": "int eq"},
    {"table": "cast_info", "predicate": "note IN 5-set", "selectivity": 0.05, "method": "varlen interned compare"},
    {"table": "name", "predicate": "gender='m'", "selectivity": 0.6, "method": "u8 code direct compare"}
  ],
  "data_structures": {
    "cn_ids": "hash_set<int32> (~30 entries) for mc.company_id membership",
    "k_ids": "flat_array<int32> sorted (~7 entries) for mk.keyword_id membership; linear or branchless cmp",
    "it1_id": "scalar int32",
    "it2_id": "scalar int32",
    "writer_notes": "5 literal (ptr,len) entries; linear compare",
    "mi_info_set": "2 literal (ptr,len) entries {Horror,Thriller}",
    "mv_set": "std::vector<int32_t> qualifying title.id (~200)",
    "gender_m_code": "u8 resolved at startup from gender.dict",
    "aggregation": "4x scalar MIN running values (varlen: store best ptr+len)"
  },
  "parallelism": {
    "strategy": "single_thread",
    "threads": 1,
    "notes": "mv_set size in hundreds; per-mv work is bounded; overhead of partitioning exceeds gains. Dim scans negligible."
  },
  "indexes": [
    {"index": "movie_companies__movie_id offsets_only", "purpose": "per-mv range scan of mc rows"},
    {"index": "movie_keyword__movie_id offsets_only", "purpose": "per-mv range scan of mk rows"},
    {"index": "movie_info__movie_id offsets_only", "purpose": "per-mv range scan of mi rows"},
    {"index": "movie_info_idx__movie_id offsets_only", "purpose": "per-mv range scan of mi_idx rows"},
    {"index": "cast_info__movie_id offsets_only", "purpose": "per-mv range scan of ci rows"}
  ],
  "aggregation": "scalar_running_min_x4",
  "output": {"order_by": [], "limit": 1, "projection": ["MIN(mi.info)", "MIN(mi_idx.info)", "MIN(n.name)", "MIN(t.title)"]},
  "execution_target": "cpp"
}
