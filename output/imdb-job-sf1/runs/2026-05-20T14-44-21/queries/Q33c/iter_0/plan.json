{
  "query_id": "Q33c",
  "pipeline": [
    "resolve_dim_ids",
    "build_cn1_bitset",
    "build_kt_title_bitset",
    "iterate_ml_via_link_type_csr",
    "probe_t1_t2_filters",
    "probe_mc1_mc2_via_mc_movie_id_index",
    "probe_mi_idx1_mi_idx2_via_mi_movie_id_index",
    "running_min_aggregation"
  ],
  "join_order": [
    {
      "build": "link_type(filtered link IN {sequel,follows,followed by})",
      "probe": "movie_link via movie_link__link_type_id CSR",
      "type": "semi",
      "strategy": "csr_index_lookup",
      "build_cardinality": 3,
      "notes": "lt has 18 rows; resolve to <=3 lt_ids; CSR yields a few hundred ml rows"
    },
    {
      "build": "kind_type(filtered kind IN {tv series,episode})",
      "probe": "title via title__kind_id CSR -> kt_title_bitset(2528312)",
      "type": "semi",
      "strategy": "bitset_membership",
      "build_cardinality": 2,
      "notes": "pre-build bitset of titles matching kt_ids; used to filter both t1 and t2"
    },
    {
      "build": "company_name(country_code != us_code && code != 0)",
      "probe": "mc1.company_id",
      "type": "semi",
      "strategy": "bitset_membership",
      "build_cardinality": 200000,
      "notes": "dense bitset(234998) over company_name ids"
    },
    {
      "build": "info_type(info='rating') -> single rating_id",
      "probe": "mi_idx1.info_type_id and mi_idx2.info_type_id",
      "type": "semi",
      "strategy": "scalar_equality",
      "build_cardinality": 1
    },
    {
      "build": "ml row (t1_id=movie_id, t2_id=linked_movie_id)",
      "probe": "title[t1_id-1], title[t2_id-1]",
      "type": "inner",
      "strategy": "direct_array_lookup",
      "build_cardinality": 500,
      "notes": "dense PK; check kt_title_bitset for both, production_year[t2_id-1] in [2000,2010]"
    },
    {
      "build": "surviving (t1_id,t2_id) pairs",
      "probe": "movie_companies via movie_companies__movie_id offsets",
      "type": "semi",
      "strategy": "index_nested_loop",
      "build_cardinality": 200,
      "notes": "for t1: scan mc rows requiring cn1_ids[company_id]; for t2: any mc row (no cn2 filter beyond join)"
    },
    {
      "build": "surviving pairs",
      "probe": "movie_info_idx via movie_info_idx__movie_id offsets",
      "type": "semi",
      "strategy": "index_nested_loop",
      "build_cardinality": 200,
      "notes": "for t1: info_type_id==rating_id; for t2: info_type_id==rating_id AND info < '3.5' (byte-lex)"
    }
  ],
  "filters": [
    {"table": "company_name (cn1)", "predicate": "country_code != '[us]' AND country_code != 0", "selectivity": 0.5},
    {"table": "info_type", "predicate": "info = 'rating'", "selectivity": 0.009},
    {"table": "kind_type", "predicate": "kind IN ('tv series','episode')", "selectivity": 0.286},
    {"table": "link_type", "predicate": "link IN ('sequel','follows','followed by')", "selectivity": 0.167},
    {"table": "title (t2)", "predicate": "production_year BETWEEN 2000 AND 2010", "selectivity": 0.25},
    {"table": "title (t1,t2)", "predicate": "kind_id IN kt_ids", "selectivity": 0.3},
    {"table": "movie_info_idx (mi_idx2)", "predicate": "info < '3.5' (byte-lex)", "selectivity": 0.3}
  ],
  "data_structures": {
    "lt_ids": "small int32 array (<=3)",
    "kt_ids": "small int32 array (2)",
    "rating_id": "scalar int32",
    "us_code": "scalar int32 (dict id)",
    "cn1_bitset": "bitset(234998) over company_name ids",
    "kt_title_bitset": "bitset(2528313) over title ids, pre-built via title__kind_id CSR",
    "ml_iteration": "via movie_link__link_type_id CSR (offsets+rowids)",
    "mc_lookup": "movie_companies__movie_id offsets_only index",
    "mi_lookup": "movie_info_idx__movie_id offsets_only index",
    "aggregation": "six scalar running-min strings (compared with current min via memcmp)"
  },
  "parallelism": {
    "strategy": "single_threaded",
    "threads": 1,
    "notes": "ml-driven loop processes only a few hundred rows after lt filter; parallelism overhead exceeds benefit. Pre-building kt_title_bitset is a single sequential scan; cn1_bitset is a single sequential scan over 234997 codes."
  },
  "indexes": [
    {"index": "movie_link__link_type_id (CSR)", "purpose": "driver iteration over ml rows matching lt_ids"},
    {"index": "title__kind_id (CSR)", "purpose": "pre-build kt_title_bitset"},
    {"index": "movie_companies__movie_id (offsets_only)", "purpose": "lookup mc rows per t1_id and t2_id"},
    {"index": "movie_info_idx__movie_id (offsets_only)", "purpose": "lookup mi_idx rows per t1_id and t2_id"}
  ],
  "aggregation": "scalar_running_min_six_strings",
  "output": {"order_by": [], "limit": 1, "projection": ["MIN(cn1.name)","MIN(cn2.name)","MIN(mi_idx1.info)","MIN(mi_idx2.info)","MIN(t1.title)","MIN(t2.title)"]},
  "execution_target": "cpp"
}
