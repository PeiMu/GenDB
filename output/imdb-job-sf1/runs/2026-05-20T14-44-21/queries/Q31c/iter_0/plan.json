{
  "query_id": "Q31c",
  "pipeline": [
    "resolve_info_types",
    "resolve_keywords",
    "scan_company_name_prefix",
    "expand_movie_companies_by_company",
    "probe_movie_keyword_semi",
    "probe_movie_info_filter_capture",
    "probe_movie_info_idx_filter_capture",
    "probe_cast_info_filter_capture_name",
    "capture_title",
    "aggregate_min"
  ],
  "join_order": [
    {
      "build": "info_type(info='genres')",
      "probe": "info_type",
      "type": "inner",
      "strategy": "scan_resolve_single_id",
      "build_cardinality": 1,
      "notes": "Resolve it1_id; small dim (113 rows)"
    },
    {
      "build": "info_type(info='votes')",
      "probe": "info_type",
      "type": "inner",
      "strategy": "scan_resolve_single_id",
      "build_cardinality": 1,
      "notes": "Resolve it2_id"
    },
    {
      "build": "keyword(keyword IN 7-set)",
      "probe": "keyword",
      "type": "inner",
      "strategy": "scan_resolve_to_bitset",
      "build_cardinality": 7,
      "notes": "Build k_id_set as small flat_array (<=7 ids); used for membership test"
    },
    {
      "build": "company_name(name LIKE 'Lionsgate%')",
      "probe": "company_name",
      "type": "inner",
      "strategy": "prefix_memcmp_scan",
      "build_cardinality": 30,
      "notes": "memcmp first 9 bytes; expected ~tens of company ids"
    },
    {
      "build": "cn_ids",
      "probe": "movie_companies via company_id CSR",
      "type": "inner",
      "strategy": "csr_index_lookup",
      "build_cardinality": 30,
      "notes": "Use movie_companies__company_id CSR (offsets+rowids) to expand cn_ids → mc rows → movie_ids; dedup into mv_set (hash_set)"
    },
    {
      "build": "mv_set",
      "probe": "movie_keyword via movie_id offsets",
      "type": "semi",
      "strategy": "offsets_only_index_probe",
      "build_cardinality": 5000,
      "notes": "For each mv in mv_set, scan mk rows [off[mv], off[mv+1]); require keyword_id ∈ k_id_set (linear scan of <=7 ids)"
    },
    {
      "build": "mv_set ∩ mk_filter",
      "probe": "movie_info via movie_id offsets",
      "type": "inner",
      "strategy": "offsets_only_index_probe",
      "build_cardinality": 5000,
      "notes": "Scan mi rows for mv; require info_type_id==it1_id AND info ∈ {Horror,Action,Sci-Fi,Thriller,Crime,War}; capture info varlen for MIN(mi.info)"
    },
    {
      "build": "mv survivors",
      "probe": "movie_info_idx via movie_id offsets",
      "type": "inner",
      "strategy": "offsets_only_index_probe",
      "build_cardinality": 5000,
      "notes": "Scan mi_idx rows for mv; require info_type_id==it2_id; capture info varlen for MIN(mi_idx.info)"
    },
    {
      "build": "mv survivors",
      "probe": "cast_info via movie_id offsets",
      "type": "inner",
      "strategy": "offsets_only_index_probe",
      "build_cardinality": 5000,
      "notes": "Scan ci rows for mv; require note ∈ 5-set writer; lookup name varlen at name/name.{off,dat}[person_id-1] for MIN(n.name)"
    },
    {
      "build": "mv survivors",
      "probe": "title.title",
      "type": "inner",
      "strategy": "direct_offsets_lookup",
      "build_cardinality": 5000,
      "notes": "title.id is identity; load title varlen at offsets[mv] for MIN(t.title)"
    }
  ],
  "filters": [
    {"table": "company_name", "predicate": "name LIKE 'Lionsgate%'", "selectivity": 0.00013},
    {"table": "info_type", "predicate": "info='genres'", "selectivity": 0.0089},
    {"table": "info_type", "predicate": "info='votes'", "selectivity": 0.0089},
    {"table": "keyword", "predicate": "keyword IN 7-set", "selectivity": 0.000052},
    {"table": "cast_info", "predicate": "note IN 5-writer-set", "selectivity": 0.03},
    {"table": "movie_info", "predicate": "info_type_id=it1_id AND info IN 6-set", "selectivity": 0.02},
    {"table": "movie_info_idx", "predicate": "info_type_id=it2_id", "selectivity": 0.35}
  ],
  "data_structures": {
    "it1_id": "int32_scalar",
    "it2_id": "int32_scalar",
    "k_id_set": "flat_array_int32 (<=7)",
    "writer_note_set": "flat_array_strings (5 literals) with memcmp",
    "genre_info_set": "flat_array_strings (6 literals) with memcmp",
    "cn_ids": "flat_array_int32 (~30)",
    "mv_set": "hash_set<int32> (pre-sized 8192)",
    "min_aggregators": "4x running_min_varlen (compare via memcmp; copy on improvement)"
  },
  "parallelism": {
    "strategy": "morsel_driven",
    "threads": "auto(nproc)",
    "notes": "Parallelize over mv_set entries (per-movie work); thread-local MIN aggregators reduced at end"
  },
  "indexes": [
    {"index": "movie_companies__company_id", "purpose": "csr_expand_company_to_movies"},
    {"index": "movie_keyword__movie_id", "purpose": "offsets_only_probe"},
    {"index": "movie_info__movie_id", "purpose": "offsets_only_probe"},
    {"index": "movie_info_idx__movie_id", "purpose": "offsets_only_probe"},
    {"index": "cast_info__movie_id", "purpose": "offsets_only_probe"}
  ],
  "aggregation": "scalar_min_4way",
  "output": {"order_by": [], "limit": 1},
  "execution_target": "cpp"
}
